/Result*
/Dataset*
*.pth
__pycache__*
.python-version
/evidence/artifacts/

# Rebuild: regenerable binaries. Every one of these is reproduced from primary
# data by the experiment that owns it, so the scripts and the small text
# outputs are tracked and the large artifacts are not. That is the point of
# "regenerate, don't rescue" -- see REBUILD_PLAN.md §0.1.
/rebuild/*/cache/
/rebuild/*/regen/
/rebuild/*/*.log

# D2 seed experiment scratch: regenerated by s8
/rebuild/*/seedtest/

# D2 duplicate export: 108MB of copied dataset images + figures.
# Regenerate with: rebuild/D2/d2_export_duplicates.py
# The per-pair manifest IS tracked, at rebuild/D2/out/d2_duplicate_pairs.csv
/rebuild/*/duplicates/

# D2R re-audit exports: copied dataset images, pair figures, inference output.
# Regenerate with: rebuild/D2_reaudit/d2r_export_pairs.py and d2r_reaudit.py --steps s5r
# The per-pair manifest IS tracked, at rebuild/D2_reaudit/out/d2r_duplicate_pairs.csv
/rebuild/*/pairs/
/rebuild/*/preds/

/iclr2027*
/rebuild/PAPER*