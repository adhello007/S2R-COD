\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Two tiers of the same finding.} \textbf  {Top:} six of the $41$ same-dimension re-encodes --- the CHAMELEON image above, its training-pool partner below. \textbf  {Bottom:} six of the $9$ recovered by geometric adjudication, which the same-dimension detector reports \textsc  {unchecked} because a rescale or a crop moves an image out of its dimension group; note the differing pixel dimensions in each pair's labels. \emph  {Sources:} \texttt  {chameleon\_contaminated.json}; \texttt  {D2\_FINAL\_AUDIT/out/adjudication.csv}.}}{9}{figure.3}\protected@file@percent }
