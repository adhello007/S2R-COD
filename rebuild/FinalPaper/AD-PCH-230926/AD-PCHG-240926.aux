\newlabel{tab:perrun-nc4k}{{11}{22}{Per-run metrics at full recorded precision, NC4K endpoint, for the same $39$ runs as Table~\ref {tab:perrun}. \emph {Source:} as Table~\ref {tab:perrun}}{table.11}{}}
\@writefile{lot}{\contentsline {table}{\numberline {12}{\ignorespaces The ten most-funded clusters under Equation~\ref {eq:alloc} ($N = 1000$, $\tau = 1.0$), and what the budget is actually aimed at. The target pool is $24.8\%$ CAMO, but $51.5\%$ of the generation budget lands on CAMO images --- a $2.08\times $ enrichment ($2.14\times $ under the committed assignment). The two largest quotas take $33.5\%$ of the budget, are $90.2\%$ CAMO, and between them hold $7$ of the $2026$ primary-endpoint images. \emph  {Source:} \texttt  {rebuild/DIAG/out/diag\_clusters.json}.}}{23}{table.12}\protected@file@percent }
\newlabel{tab:clustercomp}{{12}{23}{The ten most-funded clusters under Equation~\ref {eq:alloc} ($N = 1000$, $\atemp = 1.0$), and what the budget is actually aimed at. The target pool is $24.8\%$ CAMO, but $51.5\%$ of the generation budget lands on CAMO images --- a $2.08\times $ enrichment ($2.14\times $ under the committed assignment). The two largest quotas take $33.5\%$ of the budget, are $90.2\%$ CAMO, and between them hold $7$ of the $2026$ primary-endpoint images. \emph {Source:} \texttt {rebuild/DIAG/out/diag\_clusters.json}}{table.12}{}}
