\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Post-hoc interval estimates at \textbf  {eight seeds per arm}, $S_\alpha $ on both endpoints. \emph  {These decide nothing}: verdicts remain the pre-registered $2\hat  {\sigma }$ rule of Section~\ref {sec:method}. Intervals are Welch on the two arms actually compared, so they are not inflated by an arm outside the comparison. TOST (two one-sided tests;~\citealp  {lakens2017equivalence}) is run at $\delta = 0.005$; bold marks the comparisons that reject, and the final column gives the smallest $\delta $ at which each comparison \emph  {could} have concluded equivalence. \emph  {Source:} \texttt  {out/se/abc\_metrics.csv}, via \texttt  {figs/make\_tost\_table.py} using \texttt  {make\_results.py}'s \texttt  {welch\_tost}.}}{18}{table.6}\protected@file@percent }
\newlabel{tab:tost}{{6}{18}{Post-hoc interval estimates at \textbf {eight seeds per arm}, $S_\alpha $ on both endpoints. \emph {These decide nothing}: verdicts remain the pre-registered $2\hat {\sigma }$ rule of Section~\ref {sec:method}. Intervals are Welch on the two arms actually compared, so they are not inflated by an arm outside the comparison. TOST (two one-sided tests;~\citealp {lakens2017equivalence}) is run at $\delta = 0.005$; bold marks the comparisons that reject, and the final column gives the smallest $\delta $ at which each comparison \emph {could} have concluded equivalence. \emph {Source:} \texttt {out/se/abc\_metrics.csv}, via \texttt {figs/make\_tost\_table.py} using \texttt {make\_results.py}'s \texttt {welch\_tost}}{table.6}{}}
