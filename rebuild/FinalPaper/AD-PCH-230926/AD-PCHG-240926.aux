\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces \textbf  {Arms.} Every arm shares one base pool and differs only in what is appended to it. The last two columns are the axes of Figure~\ref {fig:arms}: how concentrated the allocation is, and where it points. The C-family are permutations of a single allocation, so they hold concentration fixed and differ only in direction; the digits in C10 record the allocation temperature, $\tau = 1.0$. None of A0, A2 and MT has an allocation to place.}}{4}{table.1}\protected@file@percent }
\newlabel{tab:arms}{{1}{4}{\textbf {Arms.} Every arm shares one base pool and differs only in what is appended to it. The last two columns are the axes of Figure~\ref {fig:arms}: how concentrated the allocation is, and where it points. The C-family are permutations of a single allocation, so they hold concentration fixed and differ only in direction; the digits in C10 record the allocation temperature, $\atemp = 1.0$. None of A0, A2 and MT has an allocation to place}{table.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {What each arm holds fixed and what it varies.} The horizontal axis is how concentrated an allocation is; the vertical axis is where it points, measured as rank correlation with the committed uncertainty ranking. Because the C-family are permutations of one allocation, they reproduce its shape to five decimal places and differ only vertically, which is what makes the vertical contrast clean and the diagonal one ambiguous. A0 and A2 append nothing and no generated content, respectively, so neither has an allocation to place. \emph  {Sources:} \texttt  {abc\_pools.json}; \texttt  {T2\_RESULTS.md}; \texttt  {results.md} \S  5.2.}}{4}{figure.1}\protected@file@percent }
\newlabel{fig:arms}{{1}{4}{\textbf {What each arm holds fixed and what it varies.} The horizontal axis is how concentrated an allocation is; the vertical axis is where it points, measured as rank correlation with the committed uncertainty ranking. Because the C-family are permutations of one allocation, they reproduce its shape to five decimal places and differ only vertically, which is what makes the vertical contrast clean and the diagonal one ambiguous. A0 and A2 append nothing and no generated content, respectively, so neither has an allocation to place. \emph {Sources:} \texttt {abc\_pools.json}; \texttt {T2\_RESULTS.md}; \texttt {results.md} \S 5.2}{figure.1}{}}
