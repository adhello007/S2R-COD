\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {(a)} Each point is one of the $75$ clusters, sized by how many target images it holds. The budget piles onto clusters far to the right of the pool's own CAMO share, so the allocation is partly a source selector. \textbf  {(b)} The same budget against how many primary-endpoint images each cluster contains: the two largest quotas sit at $n_{\mathrm  {test}} = 2$ and $5$. \textbf  {(c)} Endpoint error variance decomposed across the same clusters --- four fifths of it is within clusters, so a cluster-level policy cannot address it however well aimed. \emph  {Source:} \texttt  {rebuild/DIAG/out/diag\_clusters.json}.}}{17}{figure.2}\protected@file@percent }
\newlabel{fig:clusterdiag}{{2}{17}{\textbf {(a)} Each point is one of the $75$ clusters, sized by how many target images it holds. The budget piles onto clusters far to the right of the pool's own CAMO share, so the allocation is partly a source selector. \textbf {(b)} The same budget against how many primary-endpoint images each cluster contains: the two largest quotas sit at $n_{\mathrm {test}} = 2$ and $5$. \textbf {(c)} Endpoint error variance decomposed across the same clusters --- four fifths of it is within clusters, so a cluster-level policy cannot address it however well aimed. \emph {Source:} \texttt {rebuild/DIAG/out/diag\_clusters.json}}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Six of the $41$ confirmed pairs: the author-sourced CHAMELEON image (top) and its partner in the COD10K-train pool (bottom). \emph  {Selection rule, applied not curated:} the six lowest mean absolute difference among pairs with a COD10K-train partner. Exact hashing reports $0$ collisions for every pair shown, each being a re-encoding rather than a byte-identical copy. \emph  {Source:} \texttt  {chameleon\_contaminated.json} (\texttt  {EXP D2R} \#4).}}{17}{figure.3}\protected@file@percent }
\newlabel{fig:pairs}{{3}{17}{Six of the $41$ confirmed pairs: the author-sourced CHAMELEON image (top) and its partner in the COD10K-train pool (bottom). \emph {Selection rule, applied not curated:} the six lowest mean absolute difference among pairs with a COD10K-train partner. Exact hashing reports $0$ collisions for every pair shown, each being a re-encoding rather than a byte-identical copy. \emph {Source:} \texttt {chameleon\_contaminated.json} (\texttt {EXP D2R} \#4)}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Six of the $9$ CHAMELEON images that the released same-dimension detector reports \textsc  {unchecked} and the geometric extension matches: the author-sourced CHAMELEON image (top) and its partner in the training pool (bottom), with each pair's RANSAC inlier count. \emph  {Selection rule, applied not curated:} the six highest inlier counts among the newly matched. Note the differing dimensions in every pair --- that is why a same-dimension check cannot see them, and why the $41$ of Section~\ref {sec:contamination} was a lower bound. A tenth candidate cleared the inlier threshold but failed the residual test and is excluded; its homography is degenerate (Appendix~\ref {app:chamext}). \emph  {Source:} \texttt  {rebuild/FINAL\_AUDIT/out/final\_verdicts.json}.}}{18}{figure.4}\protected@file@percent }
\newlabel{fig:chamext}{{4}{18}{Six of the $9$ CHAMELEON images that the released same-dimension detector reports \textsc {unchecked} and the geometric extension matches: the author-sourced CHAMELEON image (top) and its partner in the training pool (bottom), with each pair's RANSAC inlier count. \emph {Selection rule, applied not curated:} the six highest inlier counts among the newly matched. Note the differing dimensions in every pair --- that is why a same-dimension check cannot see them, and why the $41$ of Section~\ref {sec:contamination} was a lower bound. A tenth candidate cleared the inlier threshold but failed the residual test and is excluded; its homography is degenerate (Appendix~\ref {app:chamext}). \emph {Source:} \texttt {rebuild/FINAL\_AUDIT/out/final\_verdicts.json}}{figure.4}{}}
