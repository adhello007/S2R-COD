+                    f.write('%s  Result/ABC/%s/%s/%s\n' % (h, r['runid'], e, n))
+    with gzip.open(os.path.join(ck, 'gt_files.sha256.gz'), 'wt') as f:
+        for e in ENDPOINTS:
+            for n, h in dres[os.path.join(DR, 'Dataset/Test', e, 'GT')][0]:
