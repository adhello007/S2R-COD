new file mode 100644
index 0000000..8bde70c
--- /dev/null
+++ b/rebuild/RL5B/make_jobs.py
@@ -0,0 +1,81 @@
+#!/usr/bin/env python
+"""Append one campaign's jobs to rebuild/RL5B/queue_jobs.json (append-only; a campaign is added once).
+
+Each job carries the commit that pre-registered its campaign; rl5b_queue.py refuses to launch a job
+if the pipeline files differ from that commit.
+
+  bridge   prereg/BRIDGE.md   1 SINet run (re-train of committed SINet_C10_s42), priority 1
+  e3c      prereg/E3.md       SUP-ours on real masks, SINet + SINet-v2 x seeds 42,43,45, priority 2
+  cdr      prereg/CDR.md      SINet: LU x 42,43,45,46,47 + L1/LH P1-P5 x 42,43,45 (35), priority 3
+  eq       prereg/EQ.md       SINet: B, C10, CSHUF x seeds 101-129 (87), interleaved by seed, priority 4
+  e3e      prereg/E3.md       RISE pseudo-label runs, SINet + SINet-v2 x 42,43,45, priority 5
+  cdrv2    prereg/CDR.md      SINet-v2 replication of cdr (35), priority 6
+
+Usage: .venv/bin/python rebuild/RL5B/make_jobs.py <campaign> --commit <hash>
+"""
+import argparse
+import json
+import os
+
+_HERE = os.path.dirname(os.path.abspath(__file__))
+JOBS = os.path.join(_HERE, 'queue_jobs.json')
+SPEC = {'SINet': dict(network='SINet', total_step='0253', last_epoch='039/040'),
+        'SINetv2': dict(network='SINet-v2', total_step='0127', last_epoch='099/100')}
+L1 = ['CDRL1P%d' % i for i in range(1, 6)]
+LH = ['CDRLHP%d' % i for i in range(1, 6)]
+
+
+def custom(id_, arch, method, iteration, seed, pool, tag, extra, ckpt, pool_r1, prio, campaign, commit):
+    s = SPEC[arch]
+    return dict(id=id_, kind='custom', campaign=campaign, commit=commit, priority=prio, arch=arch,
+                network=s['network'], method=method, iteration=iteration, seed=seed, pool=pool,
+                snap='Snapshot/RL5B/%s/%s' % (tag, id_), log='rebuild/RL5B/%s.log' % id_, extra=extra, ckpt=ckpt,
+                pred_root='Result/RL5B/%s/%s' % (tag, id_),
+                expect=dict(rounds=iteration, total_step=s['total_step'], last_epoch=s['last_epoch'], pool_r1=pool_r1))
+
+
+def abc(arch, arm, seed, prio, campaign, commit):
+    return dict(kind='abc', campaign=campaign, commit=commit, priority=prio, arch=arch, arm=arm, seed=seed)
+
+
+def build(campaign, commit):
+    if campaign == 'bridge':
+        return [custom('BRIDGE_SINet_C10_s42', 'SINet', 'ours', 2, 42, 'Dataset/Source/RL5B/bridge/SINet_C10_s42',
+                       'bridge', ['--save_ckpts', 'minimal', '--link_pool'], 'Tea_epoch_best.pth', 5447, 1, campaign, commit)]
+    if campaign in ('e3c', 'e3e'):
+        tag, pool, arm, prio = (('E3', 'Dataset/Source/RL5B/REAL4040', 'SUPREAL', 2) if campaign == 'e3c'
+                                else ('E3', 'Dataset/Source/RL5B/RISEPL', 'RISEPL', 5))
+        return [custom('E3_%s_%s_s%d' % (a, arm, s), a, 'source_only', 1, s, pool, tag,
+                       ['--val_net', 'student', '--save_ckpts', 'minimal'], 'Stu_epoch_best.pth', 4040, prio, campaign, commit)
+                for a in ('SINet', 'SINetv2') for s in (42, 43, 45)]
+    if campaign in ('cdr', 'cdrv2'):
+        arch, prio = ('SINet', 3) if campaign == 'cdr' else ('SINetv2', 6)
+        jobs = []
+        for s in (42, 43, 45):
+            for arm in ['CDRLU'] + L1 + LH:
+                jobs.append(abc(arch, arm, s, prio, campaign, commit))
+        for s in (46, 47):
+            jobs.append(abc(arch, 'CDRLU', s, prio, campaign, commit))
+        return jobs
+    if campaign == 'eq':
+        return [abc('SINet', arm, s, 4, campaign, commit) for s in range(101, 130) for arm in ('B', 'C10', 'CSHUF')]
+    raise SystemExit('unknown campaign %s' % campaign)
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument('campaign')
+    ap.add_argument('--commit', required=True)
+    a = ap.parse_args()
+    data = json.load(open(JOBS)) if os.path.isfile(JOBS) else dict(jobs=[], campaigns={})
+    if a.campaign in data['campaigns']:
+        raise SystemExit('campaign %s already queued (append-only)' % a.campaign)
+    new = build(a.campaign, a.commit)
+    data['jobs'].extend(new)
+    data['campaigns'][a.campaign] = dict(commit=a.commit, n_jobs=len(new))
+    json.dump(data, open(JOBS, 'w'), indent=1)
+    print('queued %d %s jobs at commit %s' % (len(new), a.campaign, a.commit))
+
+
+if __name__ == '__main__':
+    main()
diff --git a/rebuild/RL5B/make_pools.py b/rebuild/RL5B/make_pools.py
new file mode 100644
index 0000000..f363e07
--- /dev/null
+++ b/rebuild/RL5B/make_pools.py
@@ -0,0 +1,132 @@
+#!/usr/bin/env python
+"""RL5B rebuttal -- build the source pools for runs outside the ABC namespace. Builds by hardlink
+(no bytes copied); verifies before it writes a manifest; never touches an existing pool.
+
+  bridge    Dataset/Source/RL5B/bridge/SINet_C10_s42 : a fresh copy of the committed pool of
+            SINet_C10_s42. Its Image/ and GT/ digests must equal the committed ones in
+            rebuild/ABC/out/abc_pools.json.
+  real4040  Dataset/Source/RL5B/REAL4040 : the 4040 target images (COD10K-train 3040 + CAMO-train
+            1000) with their REAL masks, from the benchmark training archive
+            Dataset/_download_ws4/TrainValDataset.zip (extracted to .../extract/COD-TrainDataset).
+            Every image must be byte-identical to Dataset/Target/Image; every image must have a mask.
+  risepl    Dataset/Source/RL5B/RISEPL : the 4040 target images with RISE's released pseudo masks
+            (Dataset/External/RISE/...); every target stem must have a pseudo mask.
+
+Usage: .venv/bin/python rebuild/RL5B/make_pools.py {bridge,real4040,risepl} [--pseudo-dir DIR]
+"""
+import argparse
+import hashlib
+import json
+import os
+import sys
+
+_HERE = os.path.dirname(os.path.abspath(__file__))
+_REPO = os.path.dirname(os.path.dirname(_HERE))
+sys.path.insert(0, os.path.join(_REPO, 'rebuild'))
+import common as C                                            # noqa: E402
+
+OUT = os.path.join(_REPO, 'rebuild', 'RL5B', 'out')
+
+
+def sha(p):
+    return C.sha256(p)
+
+
+def link_tree(pairs, dst_img, dst_gt):
+    os.makedirs(dst_img)
+    os.makedirs(dst_gt)
+    for (si, sg), (di, dg) in pairs:
+        os.link(si, os.path.join(dst_img, di))
+        os.link(sg, os.path.join(dst_gt, dg))
+
+
+def bridge():
+    rid = 'SINet_C10_s42'
+    src = os.path.join(_REPO, 'Dataset', 'Source', 'ABC', rid)
+    dst = os.path.join(_REPO, 'Dataset', 'Source', 'RL5B', 'bridge', rid)
+    if os.path.exists(dst):
+        raise SystemExit('exists, not touched: %s' % dst)
+    pools = json.load(open(os.path.join(_REPO, 'rebuild', 'ABC', 'out', 'abc_pools.json')))['pools']
+    ref = pools[rid]
+    names = sorted(os.listdir(os.path.join(src, 'Image')))
+    gts = sorted(os.listdir(os.path.join(src, 'GT')))
+    pairs = [((os.path.join(src, 'Image', a), os.path.join(src, 'GT', b)), (a, b)) for a, b in zip(names, gts)]
+    link_tree(pairs, os.path.join(dst, 'Image'), os.path.join(dst, 'GT'))
+    ni, hi, _ = C.dir_digest(os.path.join(dst, 'Image'))
+    ng, hg, _ = C.dir_digest(os.path.join(dst, 'GT'))
+    ok = (hi == ref['image_digest'] and hg == ref['gt_digest'] and ni == ref['n_image'])
+    man = dict(generated=C.now(), commit=C.git_commit(), pool=os.path.relpath(dst, _REPO), source=os.path.relpath(src, _REPO),
+               n_image=ni, n_gt=ng, image_digest=hi, gt_digest=hg, committed_image_digest=ref['image_digest'],
+               committed_gt_digest=ref['gt_digest'], digests_match_committed=ok)
+    C.save_json(os.path.join(OUT, 'pool_bridge_%s.json' % rid), man)
+    print(json.dumps(man, indent=1))
+    if not ok:
+        raise SystemExit('BRIDGE POOL MISMATCH -- do not train')
+
+
+def real4040():
+    ext = os.path.join(_REPO, 'Dataset', '_download_ws4', 'extract', 'COD-TrainDataset')
+    zipf = os.path.join(_REPO, 'Dataset', '_download_ws4', 'TrainValDataset.zip')
+    tgt = os.path.join(_REPO, 'Dataset', 'Target', 'Image')
+    dst = os.path.join(_REPO, 'Dataset', 'Source', 'RL5B', 'REAL4040')
+    if os.path.exists(dst):
+        raise SystemExit('exists, not touched: %s' % dst)
+    timgs = sorted(os.listdir(tgt))
+    stems = [os.path.splitext(t)[0] for t in timgs]
+    eimg = {os.path.splitext(f)[0]: f for f in os.listdir(os.path.join(ext, 'Imgs'))}
+    egt = {os.path.splitext(f)[0]: f for f in os.listdir(os.path.join(ext, 'GT'))}
+    missing_img = [s for s in stems if s not in eimg]
+    missing_gt = [s for s in stems if s not in egt]
+    bad = [s for s in stems if s in eimg and sha(os.path.join(ext, 'Imgs', eimg[s])) != sha(os.path.join(tgt, s + os.path.splitext(eimg[s])[1]))]
+    extra = sorted(set(eimg) - set(stems))
+    ok = not (missing_img or missing_gt or bad) and len(stems) == 4040
+    man = dict(generated=C.now(), commit=C.git_commit(), pool=os.path.relpath(dst, _REPO),
+               source_archive=os.path.relpath(zipf, _REPO), source_archive_sha256=sha(zipf) if os.path.isfile(zipf) else None,
+               n_target=len(stems), n_cod10k=sum(s.startswith('COD10K') for s in stems),
+               n_camo=sum(not s.startswith('COD10K') for s in stems), missing_images=missing_img[:20],
+               missing_masks=missing_gt[:20], images_not_byte_identical_to_target=bad[:20],
+               archive_extra_images=len(extra), verified=ok)
+    if not ok:
+        C.save_json(os.path.join(OUT, 'pool_real4040.json'), man)
+        raise SystemExit('REAL4040 verification failed -- see pool_real4040.json')
+    pairs = [((os.path.join(ext, 'Imgs', eimg[s]), os.path.join(ext, 'GT', egt[s])), (eimg[s], egt[s])) for s in stems]
+    link_tree(pairs, os.path.join(dst, 'Image'), os.path.join(dst, 'GT'))
+    ni, hi, _ = C.dir_digest(os.path.join(dst, 'Image'))
+    ng, hg, _ = C.dir_digest(os.path.join(dst, 'GT'))
+    man.update(n_image=ni, n_gt=ng, image_digest=hi, gt_digest=hg)
+    C.save_json(os.path.join(OUT, 'pool_real4040.json'), man)
+    print(json.dumps(man, indent=1))
+
+
+def risepl(pseudo_dir):
+    tgt = os.path.join(_REPO, 'Dataset', 'Target', 'Image')
+    dst = os.path.join(_REPO, 'Dataset', 'Source', 'RL5B', 'RISEPL')
+    if os.path.exists(dst):
+        raise SystemExit('exists, not touched: %s' % dst)
+    timgs = sorted(os.listdir(tgt))
+    pm = {os.path.splitext(f)[0]: f for f in os.listdir(pseudo_dir)}
+    stems = [os.path.splitext(t)[0] for t in timgs]
+    missing = [s for s in stems if s not in pm]
+    man = dict(generated=C.now(), commit=C.git_commit(), pool=os.path.relpath(dst, _REPO),
+               pseudo_dir=os.path.relpath(pseudo_dir, _REPO), n_target=len(stems), n_pseudo=len(pm),
+               missing_pseudo=len(missing), missing_examples=missing[:20], verified=not missing)
+    if missing:
+        C.save_json(os.path.join(OUT, 'pool_risepl.json'), man)
+        raise SystemExit('RISE pseudo masks do not cover the 4040 target stems (%d missing)' % len(missing))
+    pairs = [((os.path.join(tgt, t), os.path.join(pseudo_dir, pm[os.path.splitext(t)[0]])),
+              (t, os.path.splitext(t)[0] + os.path.splitext(pm[os.path.splitext(t)[0]])[1])) for t in timgs]
+    link_tree(pairs, os.path.join(dst, 'Image'), os.path.join(dst, 'GT'))
+    ni, hi, _ = C.dir_digest(os.path.join(dst, 'Image'))
+    ng, hg, _ = C.dir_digest(os.path.join(dst, 'GT'))
+    man.update(n_image=ni, n_gt=ng, image_digest=hi, gt_digest=hg)
+    C.save_json(os.path.join(OUT, 'pool_risepl.json'), man)
+    print(json.dumps(man, indent=1))
+
+
+if __name__ == '__main__':
+    ap = argparse.ArgumentParser()
+    ap.add_argument('which', choices=['bridge', 'real4040', 'risepl'])
+    ap.add_argument('--pseudo-dir', default='')
+    a = ap.parse_args()
+    os.makedirs(OUT, exist_ok=True)
+    {'bridge': bridge, 'real4040': real4040}.get(a.which, lambda: risepl(a.pseudo_dir))()
diff --git a/rebuild/RL5B/rl5b_queue.py b/rebuild/RL5B/rl5b_queue.py
new file mode 100644
index 0000000..3d79172
--- /dev/null
+++ b/rebuild/RL5B/rl5b_queue.py
@@ -0,0 +1,368 @@
+#!/usr/bin/env python
+"""RL5B rebuttal -- one priority queue for every new training campaign (bridge, E3, CDR, EQ, ...).
+
+Runs, never scores. For each job it trains, verifies, and then runs inference on COD10K-test and
+NC4K in the same GPU slot. Scoring happens only after a campaign is complete, with the campaign's
+pre-committed analysis script, so nothing is looked at mid-campaign.
+
+Jobs live in an append-only JSON file (--jobs). A campaign's jobs are appended only after its
+pre-registration is committed; each job carries that commit. The file is re-read every cycle, so a
+campaign can be added while the queue runs.
+
+Job kinds
+  abc     an ABC-pipeline run (arch, arm, seed): pools, paths, command, verification and inference
+          are rebuild/ABC's own (abc_train.launch / verify_run / discard, abc_evaluate.infer_start),
+          with EXTRA_TRAIN_FLAGS = --save_ckpts minimal --link_pool (footprint only).
+  custom  an explicit run outside the ABC namespace (the bridge re-train; supervised baselines):
+          every path, the command and the expected verification values are in the job itself.
+
+Guards before every launch (the queue pauses, never skips, when one fails)
+  * branch is rebuttal/iclr27/wip2 and the pipeline files are unchanged since the job's commit
+    (git diff --quiet <commit> -- PIPELINE);
+  * free disk >= --min-free-gb (shared machine);
+  * the GPU has >= --min-gpu-free-gb free memory (never OOM another user's job).
+A run that fails verification is discarded and re-run from scratch with the SAME seed (once by
+default); it is never replaced by a new seed and never dropped silently.
+
+Usage
+  .venv/bin/python rebuild/RL5B/rl5b_queue.py --jobs rebuild/RL5B/queue_jobs.json [--dry-run]
+"""
+import argparse
+import datetime
+import hashlib
+import json
+import os
+import re
+import shutil
+import subprocess
+import sys
+import time
+
+_HERE = os.path.dirname(os.path.abspath(__file__))
+_REPO = os.path.dirname(os.path.dirname(_HERE))
+for _p in (os.path.join(_REPO, 'rebuild', 'ABC'), os.path.join(_REPO, 'rebuild'), _REPO):
+    if _p not in sys.path:
+        sys.path.insert(0, _p)
+import common as C                                            # noqa: E402
+import abc_common as A                                        # noqa: E402
+import abc_train as T                                         # noqa: E402
+import abc_evaluate as E                                      # noqa: E402
+
+PY = '.venv/bin/python'
+BRANCH = 'rebuttal/iclr27/wip2'
+PIPELINE = ['MyTrain.py', 'MyTest.py', 'CLS.py', 'Src', 'Eval/metrics.py', 'rebuild/common.py',
+            'rebuild/C1/c1_space.py', 'rebuild/C1/c1_targeted_vs_random.py', 'rebuild/ABC/abc_common.py',
+            'rebuild/ABC/abc_train.py', 'rebuild/ABC/abc_evaluate.py', 'rebuild/ABC/out/cdr/cdr_permutations.json',
+            'rebuild/RL5B/rl5b_queue.py']
+ABC_FLAGS = ['--save_ckpts', 'minimal', '--link_pool']
+ENDPOINTS = ('COD10K', 'NC4K')
+OUT = os.path.join(_REPO, 'rebuild', 'RL5B', 'out')
+EVENTS = os.path.join(OUT, 'queue_events.jsonl')
+TS = re.compile(r'^\[(\d{4}-\d\d-\d\d \d\d:\d\d:\d\d\.\d+)\]')
+EPOCH = re.compile(r'Epoch Num: (\d+/\d+)')
+STEP = re.compile(r'Global Step: \d+/(\d+)')
+
+
+def now():
+    return datetime.datetime.now().isoformat(timespec='seconds')
+
+
+def say(m):
+    print('[%s] %s' % (time.strftime('%m-%d %H:%M:%S'), m), flush=True)
+
+
+def event(**kw):
+    os.makedirs(OUT, exist_ok=True)
+    with open(EVENTS, 'a') as fh:
+        fh.write(json.dumps(dict(at=now(), **kw)) + '\n')
+
+
+def git(*args):
+    return subprocess.run(['git', '-C', _REPO] + list(args), capture_output=True, text=True)
+
+
+def pipeline_hash():
+    h = hashlib.sha256()
+    for p in PIPELINE:
+        r = git('ls-files', '-s', '--', p)
+        h.update(r.stdout.encode())
+        full = os.path.join(_REPO, p)
+        files = [full] if os.path.isfile(full) else sorted(
+            os.path.join(d, f) for d, _, fs in os.walk(full) for f in fs if f.endswith('.py'))
+        for f in files:
+            if os.path.isfile(f):
+                h.update(open(f, 'rb').read())
+    return h.hexdigest()[:16]
+
+
+def guard(job):
+    br = git('rev-parse', '--abbrev-ref', 'HEAD').stdout.strip()
+    if br != BRANCH:
+        return 'branch is %s, not %s' % (br, BRANCH)
+    r = git('diff', '--quiet', job['commit'], '--', *PIPELINE)
+    if r.returncode != 0:
+        return 'pipeline files differ from campaign commit %s' % job['commit']
+    return None
+
+
+def disk_free_gb():
+    return shutil.disk_usage(_REPO).free / 1e9
+
+
+def gpu_free_gb(gpu):
+    r = subprocess.run(['nvidia-smi', '--query-gpu=memory.free', '--format=csv,noheader,nounits', '-i', str(gpu)],
+                       capture_output=True, text=True)
+    try:
+        return float(r.stdout.strip()) / 1024
+    except ValueError:
+        return 0.0
+
+
+# ---------------------------------------------------------------- custom jobs
+def custom_cmd(job, gpu):
+    c = [PY, 'MyTrain.py', '--network', job['network'], '--task', 'S2C', '--method', job['method'],
+         '--iteration', str(job['iteration']), '--seed', str(job['seed']),
+         '--save_model', './' + job['snap'] + '/', '--source_root', './' + job['pool'] + '/',
+         '--target_root', './Dataset/Target/', '--val_root', './Dataset/Val/CAMO/'] + job.get('extra', []) + \
+        ['--gpu', str(gpu)]
+    return c
+
+
+def custom_verify(job):
+    snap = os.path.join(_REPO, job['snap'])
+    tl = os.path.join(snap, 'training_log.log')
+    d = dict(runid=job['id'])
+    if not os.path.isfile(tl):
+        return False, dict(d, fail='no training_log.log')
+    lines = open(tl).read().splitlines()
+    d['rounds'] = sum(1 for l in lines if l.startswith('Training Log'))
+    d['total_step_set'] = ','.join(sorted({m.group(1) for l in lines for m in [STEP.search(l)] if m}))
+    ep = [m.group(1) for l in lines for m in [EPOCH.search(l)] if m]
+    d['last_epoch'] = ep[-1] if ep else ''
+    st = [datetime.datetime.fromisoformat(m.group(1)) for l in lines for m in [TS.match(l)] if m]
+    d['wall_min'] = round((st[-1] - st[0]).total_seconds() / 60, 1) if st else None
+    run = open(os.path.join(_REPO, job['log'])).read() if os.path.isfile(os.path.join(_REPO, job['log'])) else ''
+    loaded = [int(x) for x in re.findall(r'Loaded (\d+) image-mask pairs', run)]
+    d['pool_r1'] = loaded[0] if loaded else None
+    d['pool_r2'] = loaded[1] if len(loaded) > 1 else None
+    d['n_appended'] = (loaded[1] - loaded[0]) if len(loaded) > 1 else None
+    be = re.findall(r'Best epoch:(\d+)', run)
+    d['best_epoch'] = int(be[-1]) if be else None
+    ex = job['expect']
+    checks = dict(rounds=d['rounds'] == ex['rounds'], total_step=d['total_step_set'] == ex['total_step'],
+                  last_epoch=d['last_epoch'] == ex['last_epoch'],
+                  ckpt=os.path.isfile(os.path.join(snap, job['ckpt'])), pool_r1=d['pool_r1'] == ex['pool_r1'])
+    d['checks'] = checks
+    d['failed_checks'] = [k for k, v in checks.items() if not v]
+    return not d['failed_checks'], d
+
+
+def custom_ready(job):
+    pool = os.path.join(_REPO, job['pool'])
+    if not os.path.isdir(os.path.join(pool, 'Image')):
+        return False, 'pool missing: %s' % job['pool']
+    if os.path.exists(os.path.join(_REPO, job['pool'].rstrip('/') + '_iteration2')):
+        return False, 'stale CLS output'
+    snap = os.path.join(_REPO, job['snap'])
+    if os.path.isdir(snap) and [f for f in os.listdir(snap) if f.endswith('.pth')]:
+        return False, 'snapshot dir already holds .pth'
+    return True, ''
+
+
+def custom_discard(job, why):
+    for p in (job['snap'], job['pool'].rstrip('/') + '_iteration2'):
+        full = os.path.join(_REPO, p)
+        if os.path.exists(full):
+            shutil.rmtree(full)
+    event(kind='discard', job=job['id'], why=why)
+
+
+# ---------------------------------------------------------------- generic
+def pred_dir(job, ep):
+    if job['kind'] == 'abc':
+        return A.pred_dir(A.runid(job['arch'], job['arm'], job['seed']), ep)
+    return os.path.join(job['pred_root'], ep)
+
+
+def infer_complete(job):
+    for ep in ENDPOINTS:
+        out = os.path.join(_REPO, pred_dir(job, ep))
+        gtn = len(os.listdir(os.path.join(_REPO, 'Dataset/Test/%s/GT' % ep)))
+        if not (os.path.isdir(out) and len(os.listdir(out)) == gtn):
+            return False
+    return True
+
+
+def trained_ok(job):
+    if job['kind'] == 'abc':
+        return T.verify_run(job['arch'], job['arm'], job['seed'])
+    return custom_verify(job)
+
+
+def start_train(job, gpu):
+    if job['kind'] == 'abc':
+        p, lg = T.launch(job['arch'], job['arm'], job['seed'], gpu)
+        return p, lg
+    cmd = custom_cmd(job, gpu)
+    os.makedirs(os.path.join(_REPO, job['snap']), exist_ok=True)
+    os.makedirs(os.path.dirname(os.path.join(_REPO, job['log'])), exist_ok=True)
+    lg = open(os.path.join(_REPO, job['log']), 'w')
+    lg.write('# RUNID   %s\n# started %s\n# commit  %s\n# CMD     %s\n\n' % (job['id'], C.now(), C.git_commit(), ' '.join(cmd)))
+    lg.flush()
+    return subprocess.Popen(cmd, cwd=_REPO, stdout=lg, stderr=subprocess.STDOUT), lg
+
+
+def start_infer(job, ep, gpu):
+    if job['kind'] == 'abc':
+        return E.infer_start(job['arch'], job['arm'], job['seed'], ep, gpu)
+    ck = './' + os.path.join(job['snap'], job['ckpt'])
+    cmd = [PY, 'MyTest.py', '--network', job['network'], '--gpu', str(gpu), '--dataset', ep,
+           '--model_path', ck, '--test_save', './' + pred_dir(job, ep)]
+    lg = open(os.path.join(_REPO, job['log'].replace('.log', '_infer_%s.log' % ep)), 'w')
+    return subprocess.Popen(cmd, cwd=_REPO, stdout=lg, stderr=subprocess.STDOUT), lg
+
+
+def ready(job):
+    if job['kind'] == 'abc':
+        return T.assert_ready(job['arch'], job['arm'], job['seed'])
+    return custom_ready(job)
+
+
+def discard(job, why):
+    if job['kind'] == 'abc':
+        journal = []
+        T.discard(job['arch'], job['arm'], job['seed'], why, journal)
+        event(kind='discard', job=job['id'], why=why)
+    else:
+        custom_discard(job, why)
+
+
+def load_jobs(path):
+    jobs = json.load(open(path))['jobs']
+    for j in jobs:
+        if j['kind'] == 'abc':
+            j.setdefault('id', A.runid(j['arch'], j['arm'], j['seed']))
+    return sorted(enumerate(jobs), key=lambda x: (x[1].get('priority', 100), x[0]))
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument('--jobs', required=True)
+    ap.add_argument('--gpus', default='0,1')
+    ap.add_argument('--slots-per-gpu', type=int, default=1)
+    ap.add_argument('--retries', type=int, default=1)
+    ap.add_argument('--min-free-gb', type=float, default=150.0)
+    ap.add_argument('--min-gpu-free-gb', type=float, default=24.0)
+    ap.add_argument('--poll', type=int, default=30)
+    ap.add_argument('--dry-run', action='store_true')
+    args = ap.parse_args()
+    T.EXTRA_TRAIN_FLAGS = list(ABC_FLAGS)
+    gpus = [int(g) for g in args.gpus.split(',')]
+    slots = [(g, i) for g in gpus for i in range(args.slots_per_gpu)]
+    running = {}          # slot -> dict(job, phase, proc, lg, ep_left)
+    attempts, gave_up, done = {}, set(), set()
+    say('queue start: slots %s, pipeline hash %s' % (slots, pipeline_hash()))
+    event(kind='queue_start', slots=slots, pipeline_hash=pipeline_hash(), head=git('rev-parse', 'HEAD').stdout.strip())
+    while True:
+        jobs = load_jobs(args.jobs)
+        busy = {s['job']['id'] for s in running.values()}
+        pending = []
+        for _, j in jobs:
+            if j['id'] in busy or j['id'] in gave_up or j['id'] in done:
+                continue
+            ok, _ = trained_ok(j)
+            if ok and infer_complete(j):
+                done.add(j['id'])
+                continue
+            pending.append((j, ok))
+        if args.dry_run:
+            for j, ok in pending:
+                say('PENDING %-26s %-8s prio %-3s %s' % (j['id'], j.get('campaign'), j.get('priority', 100),
+                                                         'trained, needs inference' if ok else 'needs training'))
+            say('done %d, pending %d' % (len(done), len(pending)))
+            return
+        # fill free slots
+        for slot in slots:
+            if slot in running or not pending:
+                continue
+            gpu = slot[0]
+            if disk_free_gb() < args.min_free_gb:
+                say('PAUSE disk free %.0f GB < %.0f GB' % (disk_free_gb(), args.min_free_gb))
+                break
+            if gpu_free_gb(gpu) < args.min_gpu_free_gb:
+                continue
+            j, trained = pending.pop(0)
+            why = guard(j)
+            if why:
+                say('PAUSE %s: %s' % (j['id'], why))
+                event(kind='guard_pause', job=j['id'], why=why)
+                pending.insert(0, (j, trained))
+                break
+            if trained:          # inference only (e.g. after a queue restart)
+                ep_left = [ep for ep in ENDPOINTS]
+                p, lg = start_infer(j, ep_left[0], gpu)
+                running[slot] = dict(job=j, phase='infer', proc=p, lg=lg, ep_left=ep_left)
+                continue
+            ok, why = ready(j)
+            if not ok:
+                discard(j, 'pre-launch: ' + why)
+                ok, why = ready(j)
+            if not ok:
+                say('SKIP %s -- %s' % (j['id'], why))
+                event(kind='not_launchable', job=j['id'], why=why)
+                gave_up.add(j['id'])
+                continue
+            p, lg = start_train(j, gpu)
+            say('TRAIN %-26s gpu %d pid %d' % (j['id'], gpu, p.pid))
+            event(kind='train_start', job=j['id'], gpu=gpu, pid=p.pid, head=git('rev-parse', 'HEAD').stdout.strip(),
+                  pipeline_hash=pipeline_hash(), campaign=j.get('campaign'), commit=j['commit'])
+            running[slot] = dict(job=j, phase='train', proc=p, lg=lg, ep_left=list(ENDPOINTS))
+        if not running and not pending:
+            say('queue idle: all jobs done or given up (done %d, gave up %d); waiting for new jobs' % (len(done), len(gave_up)))
+        time.sleep(args.poll)
+        for slot in list(running):
+            s = running[slot]
+            if s['proc'].poll() is None:
+                continue
+            s['lg'].close()
+            j, gpu = s['job'], slot[0]
+            if s['phase'] == 'train':
+                ok, d = trained_ok(j)
+                rc = s['proc'].returncode
+                n = attempts.get(j['id'], 0) + 1
+                attempts[j['id']] = n
+                if ok and rc == 0:
+                    say('OK    %-26s wall %.1fm n_appended %s best_epoch %s' % (j['id'], d['wall_min'], d['n_appended'], d['best_epoch']))
+                    event(kind='train_ok', job=j['id'], verify=d)
+                    p, lg = start_infer(j, s['ep_left'][0], gpu)
+                    running[slot] = dict(job=j, phase='infer', proc=p, lg=lg, ep_left=s['ep_left'])
+                else:
+                    why = 'rc=%s failed=%s' % (rc, d.get('failed_checks') or d.get('fail'))
+                    discard(j, why)
+                    del running[slot]
+                    if n > args.retries:
+                        gave_up.add(j['id'])
+                        say('GIVE UP %s after %d attempts (%s)' % (j['id'], n, why))
+                        event(kind='gave_up', job=j['id'], attempts=n, why=why)
+                    else:
+                        say('RETRY %s same seed (attempt %d): %s' % (j['id'], n + 1, why))
+            else:
+                ep = s['ep_left'].pop(0)
+                event(kind='infer_done', job=j['id'], endpoint=ep, rc=s['proc'].returncode)
+                if s['proc'].returncode != 0:
+                    say('INFER FAIL %s %s rc=%s' % (j['id'], ep, s['proc'].returncode))
+                    del running[slot]
+                    gave_up.add(j['id'])
+                    event(kind='infer_failed', job=j['id'], endpoint=ep)
+                elif s['ep_left']:
+                    p, lg = start_infer(j, s['ep_left'][0], gpu)
+                    running[slot] = dict(job=j, phase='infer', proc=p, lg=lg, ep_left=s['ep_left'])
+                else:
+                    say('DONE  %s (trained + inferred)' % j['id'])
+                    event(kind='job_done', job=j['id'])
+                    done.add(j['id'])
+                    del running[slot]
+
+
+if __name__ == '__main__':
+    main()
